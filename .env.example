# Kopjojeni si .env.local (lokalisht) ose vendosini te Vercel → Settings → Environment Variables.

# I detyrueshëm në prodhim. Gjenerimi:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=

# URL-ja publike, pa "/" në fund (përdoret te linqet e emailit dhe kthimi nga pagesa).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=PikëNisja

# Çmimi në cent (200 = 2,00 €) dhe ruajtja e raporteve.
PRICE_CENTS=200
CURRENCY=EUR
# Sa dite vlen linku i raportit (te dhenat jane brenda linkut, serveri nuk i ruan).
REPORT_RETENTION_DAYS=30

# Pagesa: "mock" = e simuluar (për testim).
PAYMENT_PROVIDER=mock

# Emaili: "mock" (ruhet te data/outbox) ose "smtp".
EMAIL_PROVIDER=mock
PSYCHOLOGIST_EMAIL=psikologu@example.com
FROM_EMAIL="PikëNisja <raporte@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Ruajtja: bosh = skedar JSON lokalisht, Redis kur ka kredenciale Upstash.
# STORE=file | redis
# DATA_DIR=data
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Kutia e kerkesave per ndryshim (faza e testimit). Bosh = e fikur.
# Rishikuesi hyn me /api/feedback/hyr?k=<celesi>; kerkesat ruhen te data/kerkesat.json.
FEEDBACK_KEY=

# Pas sa oresh fshihet nje porosi e papaguar (pas pageses fshihet menjehere).
PENDING_ORDER_HOURS=24
